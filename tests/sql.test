# The SQL scanner: where a statement stops meaning what it says, and which
# statements move the session.

source [file join [file dirname [info script]] helper.tcl]
namespace import -force ::tcltest::*

test sql-1.1 {a semicolon inside a string literal is not a separator} -body {
    ::frostlake::sql splitstatements {SELECT 'a;b'; SELECT 2}
} -result {{SELECT 'a;b'} { SELECT 2}}

test sql-1.2 {nor inside a quoted identifier} -body {
    llength [::frostlake::sql splitstatements {SELECT "a;b" FROM t}]
} -result 1

test sql-1.3 {nor inside a comment, of either spelling} -body {
    list [llength [::frostlake::sql splitstatements "SELECT 1 -- a; b\n"]] \
         [llength [::frostlake::sql splitstatements {SELECT 1 /* a; b */}]] \
         [llength [::frostlake::sql splitstatements "SELECT 1 // a; b\n"]]
} -result {1 1 1}

test sql-1.4 {nor inside a dollar-quoted body} -body {
    llength [::frostlake::sql splitstatements {CREATE FUNCTION f() AS $$ a; b; c $$}]
} -result 1

test sql-1.5 {a doubled quote stays inside its literal} -body {
    ::frostlake::sql splitstatements {SELECT 'it''s; here'}
} -result {{SELECT 'it''s; here'}}

test sql-1.6 {a backslash escapes, so the quote after it does not close} -body {
    llength [::frostlake::sql splitstatements {SELECT 'a\'; b'}]
} -result 1

test sql-1.7 {an unterminated literal swallows the rest rather than mis-splitting} -body {
    llength [::frostlake::sql splitstatements {SELECT 'unclosed; still}]
} -result 1

test sql-1.8 {a plain multi-statement request} -body {
    ::frostlake::sql splitstatements {A;B;C}
} -result {A B C}

test sql-2.1 {a dollar inside an identifier does not open a body} -body {
    # A$$B is a name; the semicolon after it still separates.
    llength [::frostlake::sql splitstatements {SELECT A$$B; SELECT 2}]
} -result 2

test sql-3.1 {leading words, upper-cased, comments skipped} -body {
    list [::frostlake::sql leadingwords {  select  a from t} 3] \
         [::frostlake::sql leadingwords "-- hi\n/* x */ create or replace table t" 4] \
         [::frostlake::sql leadingwords {'literal' first} 2]
} -result {{SELECT A FROM} {CREATE OR REPLACE TABLE} {}}

test sql-4.1 {the statements that move the session} -body {
    lmap sql {
        {USE DATABASE d}
        {SET v = 1}
        {UNSET v}
        {ALTER SESSION SET TIMEZONE = 'UTC'}
        {CREATE DATABASE d}
        {CREATE OR REPLACE SCHEMA s}
        {DROP SCHEMA IF EXISTS s}
        {CREATE TRANSIENT DATABASE d}
    } {::frostlake::sql changesscope $sql}
} -result {1 1 1 1 1 1 1 1}

test sql-4.2 {and the ones that do not} -body {
    lmap sql {
        {SELECT 1}
        {CREATE TABLE t (i INT)}
        {DROP TABLE t}
        {ALTER TABLE t ADD COLUMN c INT}
        {INSERT INTO t VALUES (1)}
        {CREATE OR REPLACE VIEW v AS SELECT 1}
        {}
    } {::frostlake::sql changesscope $sql}
} -result {0 0 0 0 0 0 0}

test sql-4.3 {a USE riding behind a leading SELECT still counts} -body {
    ::frostlake::sql changesscope {SELECT 1; USE DATABASE other}
} -result 1

test sql-4.4 {a USE named only inside a literal does not} -body {
    ::frostlake::sql changesscope {SELECT 'USE DATABASE other'}
} -result 0

test sql-5.1 {skipenclosure answers -1 where nothing opens} -body {
    list [::frostlake::sql skipenclosure {SELECT 1} 0] \
         [::frostlake::sql skipenclosure {a-b} 1] \
         [::frostlake::sql skipenclosure {a/b} 1]
} -result {-1 -1 -1}

test sql-5.2 {and the index just past what does} -body {
    list [::frostlake::sql skipenclosure {'ab' x} 0] \
         [::frostlake::sql skipenclosure {"ab" x} 0] \
         [::frostlake::sql skipenclosure "-- c\nx" 0] \
         [::frostlake::sql skipenclosure {/* c */x} 0]
} -result {4 4 5 7}

cleanupTests
